{
  "name": "de-zero-a-millionnaire",
  "private": true,
  "version": "1.0.0",
  "description": "De zéro à millionnaire — un simulateur de vie narratif jouable dans le navigateur.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "vitest run tests/balance.test.ts --reporter=verbose",
    "e2e": "node scripts/e2e.mjs",
    "build:single": "npm run build && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "5.0.3"
  }
}
